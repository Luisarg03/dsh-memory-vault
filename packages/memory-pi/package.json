{
  "name": "@luisarg/memory-pi",
  "version": "0.3.0",
  "type": "module",
  "description": "PI package: registers the memory vault MCP server and its skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luisarg03/dsh-memory-vault.git"
  },
  "keywords": ["pi-package"],
  "main": "extension.js",
  "exports": {
    ".": {
      "default": "./extension.js"
    }
  },
  "files": [
    "extension.js",
    "lib.js",
    "server/",
    "skills/"
  ],
  "pi": {
    "extensions": ["./extension.js"],
    "skills": ["./skills"]
  },
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
