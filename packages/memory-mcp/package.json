{
  "name": "@luisarg/memory-mcp",
  "version": "0.1.4",
  "type": "module",
  "description": "DSH MCP client for the memory vault",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luisarg03/dsh-memory-vault.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "server/",
    "skills/",
    "vault/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": "0.1.5-rc.2",
    "typescript": "^7.0.2",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  }
}
