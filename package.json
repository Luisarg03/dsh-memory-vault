{
  "name": "dsh-memory-vault",
  "private": true,
  "version": "0.1.0",
  "description": "Stack de memoria OKF para deepseek-harness: MCP server + plugins memory-mcp / memory-auto",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build && pnpm bundle",
    "bundle": "node scripts/bundle-assets.mjs",
    "test": "pnpm -r test",
    "lint": "oxlint .",
    "release:check": "node scripts/release-check.mjs",
    "release:bump": "node scripts/release-check.mjs --bump",
    "check:config": "pnpm dsh --dump-config 2>&1 | head -n 100"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0",
    "oxlint": "^1.82.0"
  }
}
